target=v24.22.1
node-version=22.23.4

# The electron-legacy npm package bundles checksums for its own win32 ia32/x64
# zips only; the linux/darwin/mas artifacts in its releases are mirrored from
# upstream and hashed in the release's SHASUMS256.txt instead. This makes
# @electron/get fetch that manifest rather than the bundled one, which is what
# lets `npm run start`/`dev` download a linux build here. Without it the
# download succeeds and then dies on
#   No checksum found in checksum file for electron-v<ver>-linux-x64.zip
# index.js spawns install.js as a child process, so this reaches it through any
# npm-run path. Not needed for electron-builder, which downloads via its own Go
# helper using electronDownload.mirror.
electron_use_remote_checksums=true
